@startuml
title applyPotentiallyChangedItem()
start

:Read previously applied DB state and incoming online state;
:Determine whether file content identity changed;

if (eTag changed?) then (yes)
  if (Online path / name changed?) then (yes)
    :Prepare local move / rename;
    if (Destination already exists?) then (yes)
      :Look up destination in DB when possible;
      if (Destination is demonstrably in sync?) then (yes)
        :Destination may be overwritten by the online move;
      else (no)
        :Create verified non-destructive safeBackup\nof conflicting destination;
        if (Preservation failed?) then (yes)
          :Abort this item without advancing state;
          stop
        endif
      endif
    endif

    if (~--dry-run?) then (yes)
      :Track simulated move only;
    else (no)
      :safeRename old path to new path;
      if (Rename failed?) then (yes)
        :Abort this item without treating it as moved;
        stop
      endif
      :Publish expected local move for monitor correlation;
      if (Pure file move with unchanged content?) then (yes)
        :Apply online timestamp to moved local file;
      endif
    endif
  endif

  if (Incoming item is file-like?) then (yes)
    if (File content identity changed?) then (yes)
      :Queue online file content for transactional download;
      if (Path was moved successfully?) then (yes)
        :Persist new location but retain old applied\ncontent identity until download commits;
      endif
    else (no)
      :Persist metadata / location change when required;
    endif
  else (no)
    :Persist directory / remote-item metadata;
    if (Renamed shared-folder shortcut?) then (yes)
      :Update associated remote DB record name;
    endif
  endif
else (no)
  if (mtime changed or generated response is in use?) then (yes)
    :Refresh DB metadata;
  else (no)
    :No applied-state change required;
  endif
endif

stop
@enduml
