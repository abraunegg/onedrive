@startuml
start
note left: Operational Mode 'onedrive --sync --local-first --resync'
:Discard previous local sync database state;
:Query OneDrive API and create new database root objects;
:Scan local filesystem for potential new items;
repeat
  :For each local file candidate;
  if (Same pathname exists online?) then (yes)
    :Compare local and online file content;
    if (Content matches?) then (yes)
      :Save online identity in rebuilt DB;
      note left: No safeBackup is created for identical bytes
    else (no)
      :Compare local and online modified times;
      if (Local is at least as new?) then (yes)
        :Upload local file as modified content;
      else (no)
        :Create and verify safeBackup copy of local file;
        :Upload safeBackup as a new file;
        :Apply newer online canonical file in bidirectional mode;
      endif
    endif
  else (no)
    :Upload new local file;
  endif
repeat while
:Query OneDrive /delta API for remaining online changes;
:Reconcile downloads transactionally;
stop
@enduml
