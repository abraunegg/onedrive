@startuml
start
note left: Operational Mode 'onedrive -s --local-first'
:Perform database consistency and integrity check;
note left: Local filesystem is evaluated first for upload intent
repeat
  :Process each DB record;
  if (DB record in sync with local file?) then (yes)
  else (no)
    :Flag item as locally modified;
  endif
repeat while

:Process modified items to upload;
if (Latest online file is newer and differs?) then (yes)
  :Create and verify safeBackup copy of local file;
  note left: Canonical local pathname remains present
  :Upload safeBackup as a new file;
  :Apply newer online canonical file in bidirectional mode;
else (no)
  :Upload local modified file normally;
endif

:Scan local filesystem for new data to upload;
:Query OneDrive /delta API for online changes;
:Reconcile remaining online changes transactionally;
stop
@enduml
