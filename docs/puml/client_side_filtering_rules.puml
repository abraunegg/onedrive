@startuml
title Client-Side Filtering - Local and Online Evaluation Paths

start
if (What is being evaluated?) then (Local filesystem path)
  partition "checkPathAgainstClientSideFiltering()" {
    if (Path exists locally?) then (no)
      :No local exclusion can be evaluated;
      :Return false;
      stop
    endif

    if (~--check-for-nosync and directory contains .nosync?) then (yes)
      :Exclude local path;
      :Return true;
      stop
    endif

    if (skip_dotfiles and path is dotfile?) then (yes)
      if (sync_list configured?) then (no)
        :Exclude dotfile;
        :Return true;
        stop
      else (yes)
        :Defer final dotfile decision until sync_list check;
      endif
    endif

    if (Path is a symbolic link?) then (yes)
      if (skip_symlinks enabled?) then (yes)
        :Exclude symbolic link;
        :Return true;
        stop
      else (no)
        :Validate target, including supported relative link resolution;
        if (Target is invalid?) then (yes)
          :Exclude invalid symbolic link;
          :Return true;
          stop
        endif
      endif
    endif

    :Evaluate skip_dir / skip_file;
    if (Excluded?) then (yes)
      :Return true;
      stop
    endif

    if (sync_list configured?) then (yes)
      :Evaluate sync_list against normalised path;
      if (Excluded by sync_list?) then (yes)
        if (Root file and sync_root_files enabled?) then (yes)
          :Keep included;
        else (no)
          :Exclude path;
          :Return true;
          stop
        endif
      endif
    endif

    if (File and skip_size threshold reached?) then (yes)
      :Exclude file;
      :Return true;
      stop
    endif

    :Return false;
  }
else (OneDrive JSON item)
  partition "checkJSONAgainstClientSideFiltering()" {
    :Validate required JSON identity / parent fields;
    if (Malformed JSON?) then (yes)
      :Exclude item;
      :Return true;
      stop
    endif

    note right
      .nosync, local dotfile detection and local
      symlink checks cannot be evaluated directly
      from an online JSON object in this function.
    end note

    :Build logical path using DB parent state,\nparentReference data and shared-folder anchors;
    :Evaluate skip_dir;
    :Evaluate skip_file;
    :Evaluate sync_list and sync_root_files;
    if (Included sync_list child has missing local parent structure?) then (yes)
      :Create required parent DB/local path structure;
    endif
    :Evaluate skip_size from JSON file size;
    :Return exclusion result;
  }
endif
@enduml
